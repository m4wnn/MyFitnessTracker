{
  "db": {
    "type": "sqlite"
  },
  "garmin": {
    "domain": "garmin.com"
  },
  "credentials": {
    "user": "<garmin-email>",
    "secure_password": false,
    "password": "",
    "password_file": "secrets/.garmin_password"
  },
  "data": {
    "weight_start_date": "08/01/2025",
    "sleep_start_date": "08/01/2025",
    "rhr_start_date": "08/01/2025",
    "hrv_start_date": "08/01/2025",
    "monitoring_start_date": "08/01/2025",
    "download_latest_activities": 25,
    "download_all_activities": 200
  },
  "directories": {
    "relative_to_home": false,
    "base_dir": "data/raw/HealthData",
    "mount_dir": "/Volumes/GARMIN"
  },
  "enabled_stats": {
    "monitoring": true,
    "steps": true,
    "itime": true,
    "sleep": true,
    "rhr": true,
    "hrv": true,
    "weight": true,
    "activities": true
  },
  "course_views": {
    "steps": []
  },
  "modes": {},
  "activities": {
    "display": []
  },
  "settings": {
    "metric": true,
    "default_display_activities": [
      "walking",
      "running",
      "cycling"
    ]
  },
  "checkup": {
    "look_back_days": 90
  }
}
